<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DysinIDE.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <Color x:Key="Bg0">#000000</Color>
    <Color x:Key="Bg1">#0A0A0A</Color>
    <Color x:Key="Bg2">#121212</Color>
    <Color x:Key="Bg3">#1A1A1A</Color>
    <Color x:Key="Bg4">#262626</Color>
    <Color x:Key="Line">#2B2B2B</Color>
    <Color x:Key="Fg0">#FFFFFF</Color>
    <Color x:Key="Fg1">#D4D4D4</Color>
    <Color x:Key="Fg2">#8A8A8A</Color>
    <Color x:Key="Fg3">#5A5A5A</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}" />
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}" />
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}" />
    <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="Fg0Brush" Color="{StaticResource Fg0}" />
    <SolidColorBrush x:Key="Fg1Brush" Color="{StaticResource Fg1}" />
    <SolidColorBrush x:Key="Fg2Brush" Color="{StaticResource Fg2}" />
    <SolidColorBrush x:Key="Fg3Brush" Color="{StaticResource Fg3}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFFFFF" Opacity="0.22" />

    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{StaticResource Bg2}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource Bg2}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#8A8A8A" />

    <FontFamily x:Key="UiFont">avares://DysinIDE/assets/ibm-plex-mono#IBM Plex Mono</FontFamily>

  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://DysinIDE/Theme.axaml" />
  </Application.Styles>
</Application>
