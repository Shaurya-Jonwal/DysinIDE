<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <AvaloniaResource Include="Assets\favicon.ico" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-Regular.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-Bold.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-Italic.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-BoldItalic.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-Medium.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-MediumItalic.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-SemiBold.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-SemiBoldItalic.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-Light.ttf" />
    <AvaloniaResource Include="Assets\ibm-plex-mono\IBMPlexMono-LightItalic.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DysinIDE</RootNamespace>
    <AssemblyName>DysinIDE</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.1.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.1.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="1.0.65" />
  </ItemGroup>

</Project>
